[sub_resource type="GDScript" id="GDScript_1l0tm"]
script/source = "extends Node

@export var hearts : Array[Node]
@onready var points_label: Label = %\"points label\"

var points = 0

func add_point():
	points += 1
	print(points)
	points_label.text = \"Feathers: \" + str(points)


var lives = 3

func decrease_health():
	lives -= 1
	print(lives)
	for h in 3:
		if (h < lives):
			hearts[h].show()
		else:
			hearts[h].hide()
	if (lives == 0):
		get_tree().reload_current_scene()
"

